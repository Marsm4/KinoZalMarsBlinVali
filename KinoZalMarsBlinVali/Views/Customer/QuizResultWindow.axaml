<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результаты викторины"
        Width="400" Height="300"
        x:Class="KinoZalMarsBlinVali.Views.QuizResultWindow">
    <Grid Margin="20">
        <StackPanel Spacing="15" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="ResultTitle" FontSize="20" FontWeight="Bold" 
                      HorizontalAlignment="Center"/>
            <TextBlock x:Name="ScoreText" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock x:Name="BonusText" FontSize="14" HorizontalAlignment="Center"/>
            <Button Content="OK" Click="OKButton_Click" 
                    Classes="primary" 
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>